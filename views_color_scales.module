<?php

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\views_color_scales\Hook\ViewsColorScalesHooks;

/**
 * @file
 * Views Color Scales module for Excel-style color scaling in Views.
 */

/**
 * Implements hook_help().
 */
#[LegacyHook]
function views_color_scales_help($route_name, $route_match) {
  return \Drupal::service(ViewsColorScalesHooks::class)->help($route_name, $route_match);
}


/**
 * Implements hook_views_data_alter().
 */
#[LegacyHook]
function views_color_scales_views_data_alter(array &$data) {
  \Drupal::service(ViewsColorScalesHooks::class)->viewsDataAlter($data);
}
