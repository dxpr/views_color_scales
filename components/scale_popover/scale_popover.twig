<span class="vcs-value"
      tabindex="0"
      style="--vcs-bg: {{ bg_color }}; --vcs-fg: {{ text_color }};"
      data-vcs-popover="{{ popover_id }}"
      aria-describedby="{{ popover_id }}"
      title="{{ 'Value: @value (Range: @min to @max)'|t({'@value': display_value, '@min': range_min, '@max': range_max}) }}">{{ display_value }}</span>
<div id="{{ popover_id }}" class="vcs-popover" popover role="tooltip">
    {% if min_label or mid_label or max_label %}
        <div class="vcs-popover-labels">
            <span class="vcs-popover-label vcs-popover-label--min">{{ min_label }}</span>
            <span class="vcs-popover-label vcs-popover-label--mid">{{ mid_label }}</span>
            <span class="vcs-popover-label vcs-popover-label--max">{{ max_label }}</span>
        </div>
    {% endif %}
    <div class="vcs-popover-scale" style="--vcs-min-color: {{ min_color }}; --vcs-max-color: {{ max_color }}; --vcs-pos: {{ position }};">
        <span class="vcs-popover-marker"></span>
        <span class="vcs-popover-value">{{ display_value }}</span>
    </div>
    <div class="vcs-popover-range">
        <span class="vcs-popover-range-min">{{ range_min }}</span>
        <span class="vcs-popover-range-max">{{ range_max }}</span>
    </div>
</div>
